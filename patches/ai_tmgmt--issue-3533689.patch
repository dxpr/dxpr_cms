+    $model_selection_type = $settings['model_selection_type'] ?? 'basic';
+    
+    // Handle the three different translation methods.
+    switch ($model_selection_type) {
+      case 'ai_translate':
+        // Option 1: Use AI Translate module's per-language prompts directly via chat interface.
+        // This bypasses the translate_text operation to avoid delegating to provider translation methods.
+        
+        // Verify AI Translate module is enabled and configured.
+        if (!\Drupal::moduleHandler()->moduleExists('ai_translate')) {
+          throw new TMGMTException('AI Translate module is not available. Please enable the ai_translate module.');
+        }
+        
+        $ai_translate_config = \Drupal::configFactory()->get('ai_translate.settings');
+        if (empty($ai_translate_config->get('prompt'))) {
+          throw new TMGMTException('AI Translate module is not configured. Please configure translation prompts at /admin/config/ai/translate.');
+        }
+        
+        /** @var \Drupal\ai\AiProviderPluginManager $provider_manager */
+        $provider_manager = \Drupal::service('ai.provider');
+        
+        // Get the default chat provider (not translate_text provider) to avoid provider delegation.
+        $chat_config = $provider_manager->getDefaultProviderForOperationType('chat');
+        
+        if (empty($chat_config) || !isset($chat_config['provider_id'])) {
+          throw new TMGMTException('No default chat provider configured. Please configure a chat provider in AI settings for AI Translate to work.');
+        }
+        
+        // Load target language for per-language prompt lookup.
+        $target_lang = \Drupal::entityTypeManager()
+          ->getStorage('configurable_language')
+          ->load($request_query['target']);
+          
+        if (!$target_lang) {
+          throw new TMGMTException('Invalid target language: ' . $request_query['target']);
+        }
+        
+        // Get AI Translate's prompt - check for language-specific prompt first.
+        $prompt = $ai_translate_config->get($target_lang->getId() . '_prompt');
+        if (empty($prompt)) {
+          $prompt = $ai_translate_config->get('prompt');
+        }
+        
+        // Prepare context for Twig template.
+        $context = [
+          'dest_lang' => $target_lang->getId(),
+          'dest_lang_name' => $target_lang->getName(),
+          'input_text' => $chunk,
+        ];
+        
+        // Add source language context if available.
+        if (!empty($request_query['source'])) {
+          $source_lang = \Drupal::entityTypeManager()
+            ->getStorage('configurable_language')
+            ->load($request_query['source']);
+          if ($source_lang) {
+            $context['source_lang'] = $source_lang->getId();
+            $context['source_lang_name'] = $source_lang->getName();
+          }
+        }
+        
+        // Render AI Translate's prompt template.
+        $twig = \Drupal::service('twig');
+        $prompt_text = $twig->renderInline($prompt, $context);
+        
+        // Use direct chat interface to avoid translate_text delegation to provider methods.
+        /** @var \Drupal\ai\OperationType\Chat\ChatInterface $chat_provider */
+        $chat_provider = $provider_manager->createInstance(
+          $chat_config['provider_id'], 
+          $chat_config['config'] ?? []
+        );
+        
+        $messages = new \Drupal\ai\OperationType\Chat\ChatInput([
+          new \Drupal\ai\OperationType\Chat\ChatMessage('system', 'You are a helpful translator.'),
+          new \Drupal\ai\OperationType\Chat\ChatMessage('user', $prompt_text),
+        ]);
+        
+        $chat_output = $chat_provider->chat($messages, $chat_config['model_id'] ?? 'default');
+        
+        return $chat_output->getNormalized()->getText();
+        
+      case 'provider_interface':
+        // Option 2: Use the provider's native translation interface directly.
+        /** @var \Drupal\ai\AiProviderPluginManager $provider_manager */
+        $provider_manager = \Drupal::service('ai.provider');
+        
+        // Get the default provider configuration for translate_text.
+        $provider_config = $provider_manager->getDefaultProviderForOperationType('translate_text');
+        
+        if (empty($provider_config) || !isset($provider_config['provider_id'])) {
+          throw new TMGMTException('No default provider configured for translate_text operation. Please configure it in the AI settings.');
+        }
+        
+        // Create the provider instance.
+        /** @var \Drupal\ai\OperationType\TranslateText\TranslateTextInterface $provider */
+        $provider = $provider_manager->createInstance(
+          $provider_config['provider_id'],
+          $provider_config
+        );
+        
+        // Note: We don't check instanceof TranslateTextInterface here because the provider
+        // may be wrapped in a ProviderProxy that delegates calls to the underlying provider.
+        
+        // Create translation input.
+        $translate_input = new \Drupal\ai\OperationType\TranslateText\TranslateTextInput(
+          $chunk,
+          $request_query['source'] ?: NULL,
+          $request_query['target']
+        );
+        
+        // Perform translation using the provider's native interface.
+        $translate_output = $provider->translateText(
+          $translate_input,
+          $provider_config['model_id'] ?? 'default'
+        );
+        
+        return $translate_output->getNormalized();
+        
+      case 'basic':
+      default:
+        // Option 3: Use basic chat-based translation with custom prompt.
+        $site_languages = \Drupal::languageManager()->getLanguages();
+        $prompt = $settings['advanced']['prompt'] ?? 'Translate from %source% into %target% language';
+
+        // Replace the source and target language in the prompt.
+        $system_prompt = str_replace(
+          ['%source%', '%target%'],
+          [
+            $site_languages[$request_query['source']]->getName(),
+            $site_languages[$request_query['target']]->getName(),
+          ],
+          $prompt,
+        );
+
+        /** @var \Drupal\ai\AiProviderPluginManager $provider_manager */
+        $provider_manager = \Drupal::service('ai.provider');
+        /** @var \Drupal\ai\OperationType\Chat\ChatInterface $provider */
+        $provider = $provider_manager->loadProviderFromSimpleOption($settings['chat_model']);
+        $model_id = $provider_manager->getModelNameFromSimpleOption($settings['chat_model']);
+        $messages = new ChatInput([
+          new chatMessage('system', $system_prompt),
+          new chatMessage('user', $chunk),
+        ]);
+        return $provider->chat($messages, $model_id)->getNormalized()->getText();
+    }
   }
 
