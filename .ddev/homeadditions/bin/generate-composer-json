#!/usr/bin/env php
<?php

// Generates the production-ready `composer.json` file by copying the
// project template and adding recipe path repositories. This script must
// be run from the repository root.

$read_json = function (string $file): array {
  $data = file_get_contents($file);
  return json_decode($data, TRUE, flags: JSON_THROW_ON_ERROR);
};

// Start with the project template as the base
$data = $read_json('project_template/composer.json');

// Add recipe path repositories by scanning the recipes directory
if (is_dir('recipes')) {
  $recipe_dirs = array_filter(scandir('recipes'), function($dir) {
    return $dir !== '.' && $dir !== '..' && is_dir("recipes/$dir");
  });
  
  foreach ($recipe_dirs as $recipe_dir) {
    // Extract recipe name from directory (remove dxpr_cms_ prefix if present)
    $recipe_name = str_replace('dxpr_cms_', '', $recipe_dir);
    $data['repositories'][$recipe_name] = [
      'type' => 'path',
      'url' => "recipes/$recipe_dir"
    ];
  }
}

// Always use production mode - no development patches or source installs

// Add stability flags for packages that only have dev versions available
if (isset($data['require']['drupal/dxpr_cms_ai'])) {
  $data['require']['drupal/views_color_scales'] = '*@dev';
}
if (isset($data['require']['drupal/dxpr_cms_starter'])) {
  $data['require']['drupal/gin'] = '5.0.x-dev@dev';
}

// If in a CI environment, make all path repository URLs absolute.
if (getenv('CI') || getenv('TUGBOAT_PREVIEW')) {
  array_walk($data['repositories'], function (array &$repository): void {
    if ($repository['type'] === 'path') {
      $repository['url'] = getcwd() . '/' . $repository['url'];
    }
  });
}

// Make packages.drupal.org the lowest-priority repository, which will force the
// components' local path repositories to take precedence.
$repository = $data['repositories']['drupal'];
unset($data['repositories']['drupal']);
$data['repositories']['drupal'] = $repository;

echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
